# OpsPilot environment variables (example).
# Copy to .env and fill in. .env is gitignored.

# Where OpsPilot stores per-user state (KB, sessions, audit logs).
# Defaults to ~/.opspilot when unset. If you override it, use an absolute
# path — $HOME is not expanded when HOME is unset (containers, systemd),
# which silently creates a literal "$HOME/" directory in the workdir.
# OPSPILOT_HOME=/absolute/path/to/state-dir

# API bearer token (ADR-0011) — now the Service token (ADR-0020): machine
# callers (Telegram / JSM / webhook) authenticate with it as a svc: operator.
# Still required to bind beyond loopback. Generate: openssl rand -hex 32
# OPSPILOT_API_TOKEN=

# Multi-user auth (ADR-0020). On first start with no users, these create the
# bootstrap admin (local source, break-glass). Remove after the admin exists.
# OPSPILOT_BOOTSTRAP_ADMIN=admin
# OPSPILOT_BOOTSTRAP_PASSWORD=
# LDAP / OIDC connection secrets are read here (env-only, never stored); the
# admin module reports their status but never persists them.
#
# LDAP / Active Directory (ADR-0020) — one connector for both. OpenLDAP:
#   USER_FILTER=(uid={username}). Active Directory: (sAMAccountName={username}).
# OPSPILOT_LDAP_URL=ldap://dc.corp.example
# OPSPILOT_LDAP_BASE_DN=dc=corp,dc=example
# OPSPILOT_LDAP_USER_FILTER=(uid={username})
# OPSPILOT_LDAP_BIND_DN=cn=svc-opspilot,ou=svc,dc=corp,dc=example
# OPSPILOT_LDAP_BIND_PASSWORD=
# OPSPILOT_LDAP_GROUP_ATTR=memberOf
#
# OIDC SSO (ADR-0020) — any OIDC IdP (Entra ID / Keycloak / Google / Okta /
# Authentik). Redirect URL must be <public-base>/api/auth/oidc/callback.
# OPSPILOT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OPSPILOT_OIDC_CLIENT_ID=
# OPSPILOT_OIDC_CLIENT_SECRET=
# OPSPILOT_OIDC_REDIRECT_URL=https://opspilot.example/api/auth/oidc/callback
# OPSPILOT_OIDC_ROLE_CLAIM=groups
# OPSPILOT_OIDC_SCOPES=openid profile email

# Logging
OPSPILOT_LOG_LEVEL=INFO

# Embeddings — OpenAI by default (it needs OPENAI_API_KEY below), Ollama on
# request. Unset, a configured OPENAI_API_KEY selects OpenAI and its absence
# falls back to a local Ollama. Set this to keep embeddings local while still
# using cloud models for chat.
# OPSPILOT_EMBED_PROVIDER=ollama
# The OpenAI embedding model, requested at 768-dim to match the KB.
# OPSPILOT_OPENAI_EMBED_MODEL=text-embedding-3-small
#
# Vectors from two embedders are not comparable, and both defaults are 768
# wide, so a KB built under one would open under the other and return noise.
# The server refuses to start on that mismatch; re-ingest the KB under the
# current embedder, or set this to open it anyway.
# OPSPILOT_ALLOW_EMBED_MISMATCH=1

# Ollama (local, no key needed) — local chat models, and embeddings when
# selected above.
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434
# Request timeout in seconds. Raise for large local models (e.g. gemma4:12b)
# that take longer to cold-load + generate.
OPSPILOT_OLLAMA_TIMEOUT_S=300

# Server playbook defaults (all English out of the box). Set the zh
# variants to switch the pipeline to Chinese:
# OPSPILOT_DEFAULT_PLAYBOOK=pb_ticket_summary_zh
# OPSPILOT_CLASSIFY_PLAYBOOK=pb_classify_work_item_zh
# OPSPILOT_REQUEST_PLAYBOOK=pb_request_fulfillment_zh
# The ask (decision 5), written when the Judgments stage finds an Incident too
# thin to act on (#229):
# OPSPILOT_ASK_PLAYBOOK=pb_ask_en

# Judgments stage (ADR-0040), off by default. On, an undeclared Work item's
# type is decided by a Judgment against judgments/decisions/d2.yaml instead of
# by Classification's 0.7 cut; the server refuses to start while d2.yaml has no
# threshold for the engine that would decide it, measured on the label set,
# never guessed. Decision 1 (d1.yaml), which would ask every Work item first
# and stop a possible security issue for a person, runs only once d1.yaml has
# a threshold for its engine. It has none: as measured it is not ready to be
# automated (#281), so the stage runs without it and says so at startup.
# For an Incident, Impact (d7.yaml) and Urgency (d8.yaml) are asked before its
# summary; when both clear their cuts, Severity is read off severity.yaml and
# the summary Playbook is given it, and otherwise it suggests one as before.
# The team (d6.yaml, whose answers are the team list) is asked too: one that
# clears its cut is the escalation hint, and otherwise the hint says a person
# picks the team. First of all, enough to act on (d4.yaml): a `no` that clears
# its cut means no summary yet; the reporter is asked one question
# (pb_ask_en) on JSM or Telegram, and their reply runs the Work item again.
# Where the source lists open Work items from the last hour (JSM), already
# open (d3.yaml) names a match in the comment for a person to link. A service
# request is matched to an item of catalog.yaml (r1.yaml), whose approval,
# entitlement, stock and automation are looked up, not decided by a model; one
# that is really an incident (r2.yaml) takes the incident path, and a change
# stops for a person.
# OPSPILOT_JUDGMENTS=1
#
# With a TypeSafe key the stage asks Jev (jev-1.13.0), and the classification
# Playbook's model answers when Jev cannot; an answer from that fallback always
# goes to a person, or for Severity leaves it to the summary Playbook. Without a
# key, the Playbook's model decides alone.
# TYPESAFE_API_KEY=

# Telegram channel adapter (assist mode) — see docs/channels.md.
# TELEGRAM_BOT_TOKEN=

# WeCom notify channel (group-robot webhook; the URL embeds the secret
# key) — intake suggestions are pushed to the group when set.
# WECOM_WEBHOOK_URL=

# WeCom assist mode (self-built app callback; ADR-0019) — all five must be
# set or the callback routes answer 404. Requires public HTTPS (ADR-0011).
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=
# WECOM_CALLBACK_TOKEN=
# WECOM_ENCODING_AES_KEY=

# Cloud providers — fill in whichever you use.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...
# GROK_API_KEY=xai-...

# Web search for the chat agent (#120). When set, the assistant can call a
# web_search tool (Brave Search API). Off when unset — the query egresses to
# Brave, so this is opt-in.
# BRAVE_API_KEY=...

# JSM intake source (ADR-0013) — see docs/sources.md.
# JSM_BASE_URL=https://yoursite.atlassian.net
# JSM_EMAIL=you@example.com
# JSM_API_TOKEN=
# JSM_JQL=project = IT AND status = "Open"
# JSM_POLL_INTERVAL=60
