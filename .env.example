# OpsPilot environment variables (example).
# Copy to .env and fill in. .env is gitignored.

# Where OpsPilot stores per-user state (KB, sessions, audit logs).
# Defaults to ~/.opspilot when unset. If you override it, use an absolute
# path — $HOME is not expanded when HOME is unset (containers, systemd),
# which silently creates a literal "$HOME/" directory in the workdir.
# OPSPILOT_HOME=/absolute/path/to/state-dir

# API bearer token (ADR-0011). Required to bind beyond loopback; every
# endpoint except /health then needs "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
# OPSPILOT_API_TOKEN=

# Logging
OPSPILOT_LOG_LEVEL=INFO

# Ollama (local, no key needed)
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434
# Request timeout in seconds. Raise for large local models (e.g. gemma4:12b)
# that take longer to cold-load + generate.
OPSPILOT_OLLAMA_TIMEOUT_S=300

# Server playbook defaults (all English out of the box). Set the zh
# variants to switch the pipeline to Chinese:
# OPSPILOT_DEFAULT_PLAYBOOK=pb_ticket_summary_zh
# OPSPILOT_CLASSIFY_PLAYBOOK=pb_classify_work_item_zh
# OPSPILOT_REQUEST_PLAYBOOK=pb_request_fulfillment_zh

# Telegram channel adapter (assist mode) — see docs/channels.md.
# TELEGRAM_BOT_TOKEN=

# WeCom notify channel (group-robot webhook; the URL embeds the secret
# key) — intake suggestions are pushed to the group when set.
# WECOM_WEBHOOK_URL=

# WeCom assist mode (self-built app callback; ADR-0019) — all five must be
# set or the callback routes answer 404. Requires public HTTPS (ADR-0011).
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=
# WECOM_CALLBACK_TOKEN=
# WECOM_ENCODING_AES_KEY=

# Cloud providers — fill in whichever you use.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...
# GROK_API_KEY=xai-...

# JSM intake source (ADR-0013) — see docs/sources.md.
# JSM_BASE_URL=https://yoursite.atlassian.net
# JSM_EMAIL=you@example.com
# JSM_API_TOKEN=
# JSM_JQL=project = IT AND status = "Open"
# JSM_POLL_INTERVAL=60
